if [[ "$BIN_BACKED_UP" -eq 1 ]]; then
    /usr/bin/rm -rf -- "$BIN_BACKUP"
    BIN_BACKED_UP=0
fi
if [[ "$ENTRY_BACKED_UP" -eq 1 ]]; then
    /usr/bin/rm -f -- "$ENTRY_BACKUP"
    ENTRY_BACKED_UP=0
fi

/usr/bin/printf 'NEXT: ev424\n'
