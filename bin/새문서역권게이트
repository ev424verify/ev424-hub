#!/usr/bin/env bash
set -euo pipefail

SELF="/home/ec2-user/bin/새문서역권게이트"
CAND="/home/ec2-user/bin/문서후보서치"
DUP="/home/ec2-user/bin/문서역권중복검수"

print_help() {
cat <<HELP
=== EV424 새문서여권 1순위 게이트 (FACT / NO-INTERFERENCE) ===

[목적]
- RUN_DIR/다운로드/해시 산출 등 "간섭"이 생기는 문서역권 실행 전에
  (1) HEAD_BASELINE(HTTP 200 + application/pdf) OK
  (2) entries 기준 URL 중복 0 (DUPLICATE_URL=NO)
  를 먼저 통과시킨다.

[사용법]
1) 내용 보기(설명/계약 출력):
   새문서역권게이트

2) 게이트 수행:
   새문서역권게이트 "URL" "NAME.pdf"

[통과 조건(ALL PASS)]
- HEAD_BASELINE=OK (status=200, content-type=application/pdf)
- DUPLICATE_URL=NO (entries 내 동일 URL 없음)

[PASS 출력(고정)]
- OK_TO_RUN:
  문서역권 "URL" "NAME.pdf"

[FAIL 규칙(고정)]
- HEAD_BASELINE FAIL(404/HTML 등) 또는 중복검수 FAIL(duplicate) 즉시 STOP
- FAIL 상태에서 재시도/우회 실행/자동 조치 금지(무오염 유지)

[진행 흐름(고정)]
새문서역권게이트 PASS → 문서역권 → 문서역권2 → 문서역권3 → 문서역권4 → 문서역권5

정확성(4)=진실(2)=생명(4)
HELP
}

if [ $# -eq 0 ]; then
  print_help
  exit 0
fi

if [ $# -ne 2 ]; then
  echo "USAGE: 새문서역권게이트 \"URL\" \"NAME.pdf\"" >&2
  exit 2
fi

URL="$1"
NAME="$2"

# prerequisites
test -x "$CAND" || { echo "FAIL: missing executable: $CAND" >&2; exit 127; }
test -x "$DUP"  || { echo "FAIL: missing executable: $DUP"  >&2; exit 127; }

echo "=== NEW_DOC_PASSPORT_GATE (FACT) ==="
echo "URL=$URL"
echo "NAME=$NAME"

# 1) HEAD baseline gate (no run_dir creation)
# 문서후보서치는 내부에서 중복검수까지 포함할 수 있지만,
# 여기서는 계약상 2단 게이트를 명시적으로 출력하기 위해 분리 수행한다.

# HEAD baseline only (reuse 문서후보서치의 HEAD 파트를 실행하되, 출력에서 OK/FAIL만 신뢰)
# We call 문서후보서치 and parse its HEAD_BASELINE result.
OUT="$("$CAND" "$URL" "$NAME" 2>&1 | tr -d "\r")" || true
printf "%s\n" "$OUT"

if ! printf "%s\n" "$OUT" | grep -q "HEAD_BASELINE=OK"; then
  echo "STOP: do NOT run 문서역권"
  exit 3
fi

# 2) URL duplicate gate (entries scan)
if "$DUP" "$URL" >/tmp/ev424_doc_dupcheck_gate_last.txt 2>&1; then
  cat /tmp/ev424_doc_dupcheck_gate_last.txt
else
  RC=$?
  cat /tmp/ev424_doc_dupcheck_gate_last.txt
  if [ "$RC" -eq 10 ]; then
    echo "STOP: do NOT run 문서역권"
    exit 10
  fi
  echo "STOP: do NOT run 문서역권"
  exit "$RC"
fi

echo "=== GATE_RESULT (FACT) ==="
echo "PASS"
echo "OK_TO_RUN:"
echo "문서역권 \"$URL\" \"$NAME\""
exit 0
